#!/usr/bin/make -rRf

export DH_VERBOSE=1

%:
	dh $@

override_dh_auto_configure:
	:

override_dh_auto_build:
	:

override_dh_auto_clean:
	:

override_dh_auto_install:
	# -------- API --------
	mkdir -p debian/qcom-sensors-api/usr/lib/aarch64-linux-gnu
	cp -a data/qcom-sensors-api/arm64/usr/lib/aarch64-linux-gnu/. debian/qcom-sensors-api/usr/lib/aarch64-linux-gnu/
    mkdir -p debian/qcom-sensors-api/etc/sensors/proto
    cp -a data/qcom-sensors-api/arm64/etc/. debian/qcom-sensors-api/etc/

	# -------- API DEV --------
	mkdir -p debian/qcom-sensors-api-dev/usr/lib/aarch64-linux-gnu
	mkdir -p debian/qcom-sensors-api-dev/usr/include
	cp -a data/qcom-sensors-api-dev/arm64/usr/lib/aarch64-linux-gnu/. debian/qcom-sensors-api-dev/usr/lib/aarch64-linux-gnu/
	cp -a data/qcom-sensors-api-dev/arm64/usr/include/. debian/qcom-sensors-api-dev/usr/include/

	# -------- CORE --------
	mkdir -p debian/qcom-sensors-core/usr/lib/aarch64-linux-gnu
	cp -a data/qcom-sensors-core/arm64/usr/lib/aarch64-linux-gnu/. debian/qcom-sensors-core/usr/lib/aarch64-linux-gnu/

	# -------- CORE DEV --------
	mkdir -p debian/qcom-sensors-core-dev/usr/lib/aarch64-linux-gnu
	mkdir -p debian/qcom-sensors-core-dev/usr/include
    mkdir -p debian/qcom-sensors-core-dev/usr/lib/aarch64-linux-gnu/pkgconfig
	cp -a data/qcom-sensors-core-dev/arm64/usr/lib/aarch64-linux-gnu/. debian/qcom-sensors-core-dev/usr/lib/aarch64-linux-gnu/
	cp -a data/qcom-sensors-core-dev/arm64/usr/include/. debian/qcom-sensors-core-dev/usr/include/
    cp -a data/qcom-sensors-core-dev/arm64/usr/lib/aarch64-linux-gnu/pkgconfig/.

	# -------- REGISTRY --------
	mkdir -p debian/qcom-sensors-registry/etc/sensors
	cp -a data/qcom-sensors-registry/arm64/etc/. debian/qcom-sensors-registry/etc/

	# -------- SERVICES --------
	mkdir -p debian/qcom-sensors-services/usr/bin
	mkdir -p debian/qcom-sensors-services/usr/lib/systemd/system
	cp -a data/qcom-sensors-services/arm64/usr/bin/. debian/qcom-sensors-services/usr/bin/
	cp -a data/qcom-sensors-services/arm64/usr/lib/systemd/system/. debian/qcom-sensors-services/usr/lib/systemd/system/

	# -------- TEST CORE --------
	mkdir -p debian/qcom-sensors-test-core/usr/lib/aarch64-linux-gnu
	cp -a data/qcom-sensors-test-core/arm64/usr/lib/aarch64-linux-gnu/. debian/qcom-sensors-test-core/usr/lib/aarch64-linux-gnu/

	# -------- TEST CORE DEV --------
	mkdir -p debian/qcom-sensors-test-core-dev/usr/lib/aarch64-linux-gnu
	mkdir -p debian/qcom-sensors-test-core-dev/usr/include
	cp -a data/qcom-sensors-test-core-dev/arm64/usr/lib/aarch64-linux-gnu/. debian/qcom-sensors-test-core-dev/usr/lib/aarch64-linux-gnu/
	cp -a data/qcom-sensors-test-core-dev/arm64/usr/include/. debian/qcom-sensors-test-core-dev/usr/include/

	# -------- TEST APPS --------
	mkdir -p debian/qcom-sensors-test-apps/usr/bin
	cp -a data/qcom-sensors-test-apps/arm64/usr/bin/. debian/qcom-sensors-test-apps/usr/bin/

override_dh_install:
	:

override_dh_installsystemd:
	dh_installsystemd -p qcom-sensors-services --name=sscrpcd

override_dh_strip:
	:

override_dh_dwz:
	:

override_dh_shlibdeps:
	:

override_dh_fixperms:
	:

#!/usr/bin/make -f

export DH_VERBOSE=1

%:
	dh $@

override_dh_auto_install:
	# -------- API --------
	mkdir -p debian/qcom-sensors-api/usr/lib/aarch64-linux-gnu
	cp -a qcom-sensors-api/arm64/usr/lib/aarch64-linux-gnu/. debian/qcom-sensors-api/usr/lib/aarch64-linux-gnu/
	mkdir -p debian/qcom-sensors-api/etc/sensors/proto
	cp -a qcom-sensors-api/arm64/etc/. debian/qcom-sensors-api/etc/

	# -------- API DEV --------
	mkdir -p debian/qcom-sensors-api-dev/usr/lib/aarch64-linux-gnu
	mkdir -p debian/qcom-sensors-api-dev/usr/include
	cp -a qcom-sensors-api-dev/arm64/usr/lib/aarch64-linux-gnu/. debian/qcom-sensors-api-dev/usr/lib/aarch64-linux-gnu/
	cp -a qcom-sensors-api-dev/arm64/usr/include/. debian/qcom-sensors-api-dev/usr/include/

	# -------- CORE --------
	mkdir -p debian/qcom-sensors-core/usr/lib/aarch64-linux-gnu
	cp -a qcom-sensors-core/arm64/usr/lib/aarch64-linux-gnu/. debian/qcom-sensors-core/usr/lib/aarch64-linux-gnu/

	# -------- CORE DEV --------
	mkdir -p debian/qcom-sensors-core-dev/usr/lib/aarch64-linux-gnu
	mkdir -p debian/qcom-sensors-core-dev/usr/include
	cp -a qcom-sensors-core-dev/arm64/usr/lib/aarch64-linux-gnu/. debian/qcom-sensors-core-dev/usr/lib/aarch64-linux-gnu/
	cp -a qcom-sensors-core-dev/arm64/usr/include/. debian/qcom-sensors-core-dev/usr/include/

	# -------- REGISTRY --------
	mkdir -p debian/qcom-sensors-registry/etc/sensors
	cp -a qcom-sensors-registry/arm64/etc/. debian/qcom-sensors-registry/etc/

	# -------- SERVICES --------
	mkdir -p debian/qcom-sensors-services/usr/bin
	mkdir -p debian/qcom-sensors-services/usr/lib/systemd/system
	cp -a qcom-sensors-services/arm64/usr/bin/. debian/qcom-sensors-services/usr/bin/
	cp -a qcom-sensors-services/arm64/usr/lib/systemd/system/. debian/qcom-sensors-services/usr/lib/systemd/system/

	# -------- TEST CORE --------
	mkdir -p debian/qcom-sensors-test-core/usr/lib/aarch64-linux-gnu
	cp -a qcom-sensors-test-core/arm64/usr/lib/aarch64-linux-gnu/. debian/qcom-sensors-test-core/usr/lib/aarch64-linux-gnu/

	# -------- TEST CORE DEV --------
	mkdir -p debian/qcom-sensors-test-core-dev/usr/lib/aarch64-linux-gnu
	mkdir -p debian/qcom-sensors-test-core-dev/usr/include
	cp -a qcom-sensors-test-core-dev/arm64/usr/lib/aarch64-linux-gnu/. debian/qcom-sensors-test-core-dev/usr/lib/aarch64-linux-gnu/
	cp -a qcom-sensors-test-core-dev/arm64/usr/include/. debian/qcom-sensors-test-core-dev/usr/include/

	# -------- TEST APPS --------
	mkdir -p debian/qcom-sensors-test-apps/usr/bin
	cp -a qcom-sensors-test-apps/arm64/usr/bin/. debian/qcom-sensors-test-apps/usr/bin/

override_dh_installsystemd:
	dh_installsystemd -p qcom-sensors-services --name=sscrpcd

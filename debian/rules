#!/usr/bin/make -rRf

export DH_VERBOSE=1

%:
	dh $@

override_dh_auto_configure:
	@echo "Skipping configure (prebuilt package)"

override_dh_auto_build:
	@echo "Skipping build (prebuilt package)"

override_dh_auto_install:
	# Clean staging
	rm -rf debian/tmp
	mkdir -p debian/tmp/usr

	# -------- API --------
	cp -r data/qcom-sensors-api/arm64/usr/* debian/tmp/usr/

	# -------- API DEV --------
	cp -r data/qcom-sensors-api-dev/arm64/usr/* debian/tmp/usr/

	# -------- CORE --------
	cp -r data/qcom-sensors-core/arm64/usr/* debian/tmp/usr/

	# -------- CORE DEV --------
	cp -r data/qcom-sensors-core-dev/arm64/usr/* debian/tmp/usr/

	# -------- REGISTRY --------
	cp -r data/qcom-sensors-registry/arm64/etc debian/tmp/ || true
	cp -r data/qcom-sensors-registry/arm64/usr/* debian/tmp/usr/ || true

	# -------- SERVICES --------
	cp -r data/qcom-sensors-services/arm64/usr/* debian/tmp/usr/

	# -------- TEST CORE --------
	cp -r data/qcom-sensors-test-core/arm64/usr/* debian/tmp/usr/

	# -------- TEST CORE DEV --------
	cp -r data/qcom-sensors-test-core-dev/arm64/usr/* debian/tmp/usr/

	# -------- TEST APPS --------
	cp -r data/qcom-sensors-test-apps/arm64/usr/* debian/tmp/usr/

	# -------- TEST APPS DEV --------
	cp -r data/qcom-sensors-test-apps-dev/arm64/usr/* debian/tmp/usr/ || true

	# Cleanup unwanted files
	rm -f debian/tmp/usr/lib/$(DEB_HOST_MULTIARCH)/*.la || true
	rm -f debian/tmp/usr/lib/$(DEB_HOST_MULTIARCH)/*.*a || true
	rm -rf debian/tmp/etc/sensors/proto || true

override_dh_installsystemd:
	dh_installsystemd --name=sscrpcd
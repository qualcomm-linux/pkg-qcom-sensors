#!/usr/bin/make -f

export DH_VERBOSE = 1

%:
    dh $@

# No configure step for prebuilts
override_dh_auto_configure:
    :

# No build step for prebuilts
override_dh_auto_build:
    :

# No clean step (prebuilts, no Makefile)
override_dh_auto_clean:
    :

override_dh_auto_install:
ifeq ($(DEB_HOST_ARCH),arm64)
    mkdir -p debian/qcom-sensors-api
    cp -a data/qcom-sensors-api/arm64/* debian/qcom-sensors-api/
endif
ifeq ($(DEB_HOST_ARCH),arm64)
    mkdir -p debian/qcom-sensors-core
    cp -a data/qcom-sensors-core/arm64/* debian/qcom-sensors-core/
endif
ifeq ($(DEB_HOST_ARCH),arm64)
    mkdir -p debian/qcom-sensors-registry
    cp -a data/qcom-sensors-registry/arm64/* debian/qcom-sensors-registry/
endif
ifeq ($(DEB_HOST_ARCH),arm64)
    mkdir -p debian/qcom-sensors-services
    cp -a data/qcom-sensors-services/arm64/* debian/qcom-sensors-services/
endif
ifeq ($(DEB_HOST_ARCH),arm64)
    mkdir -p debian/qcom-sensors-test-core
    cp -a data/qcom-sensors-test-core/arm64/* debian/qcom-sensors-test-core/
endif
ifeq ($(DEB_HOST_ARCH),arm64)
    mkdir -p debian/qcom-sensors-test-apps
    cp -a data/qcom-sensors-test-apps/arm64/* debian/qcom-sensors-test-apps/
endif

override_dh_fixperms:
    :

override_dh_shlibdeps:
    :

override_dh_strip:
    :

override_dh_dwz:
    :

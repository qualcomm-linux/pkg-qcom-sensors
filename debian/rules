#!/usr/bin/make -f

export DH_VERBOSE=1

%:
	dh $@

override_dh_auto_configure:
	:

override_dh_auto_build:
	:

override_dh_auto_clean:
	:

override_dh_auto_install:
	mkdir -p debian/qcom-sensors-api
	cp -a qcom-sensors-api/arm64/* debian/qcom-sensors-api/
	mkdir -p debian/qcom-sensors-core
	cp -a qcom-sensors-core/arm64/* debian/qcom-sensors-core/
	mkdir -p debian/qcom-sensors-registry
	cp -a qcom-sensors-registry/arm64/* debian/qcom-sensors-registry/
	mkdir -p debian/qcom-sensors-services
	cp -a qcom-sensors-services/arm64/* debian/qcom-sensors-services/
	mkdir -p debian/qcom-sensors-test-core
	cp -a qcom-sensors-test-core/arm64/* debian/qcom-sensors-test-core/
	mkdir -p debian/qcom-sensors-test-apps
	# Dev packages
	mkdir -p debian/qcom-sensors-api-dev
	cp -a qcom-sensors-api-dev/arm64/* debian/qcom-sensors-api-dev/
	mkdir -p debian/qcom-sensors-core-dev
	cp -a qcom-sensors-core-dev/arm64/* debian/qcom-sensors-core-dev/
	mkdir -p debian/qcom-sensors-test-core-dev
	cp -a qcom-sensors-test-core-dev/arm64/* debian/qcom-sensors-test-core-dev/

override_dh_strip:
	:

override_dh_dwz:
	:

override_dh_shlibdeps:
	:

override_dh_fixperms:
	:
